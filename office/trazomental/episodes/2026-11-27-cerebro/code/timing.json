 ],
 "phrases": [
  {
   "text": "Tu cerebro no quiere que triunfes.",
   "start": 0.077,
   "end": 2.115,
   "w0": 0,
   "w1": 5
  },
  {
   "text": "Quiere que sobrevivas.",
   "start": 2.385,
   "end": 3.846,
   "w0": 6,
   "w1": 8
  },
  {
   "text": "Pesa el dos por ciento de tu cuerpo...",
   "start": 4.154,
   "end": 6.385,
   "w0": 9,
   "w1": 16
  },
  {
   "text": "pero se come el veinte por ciento de tu energía.",
   "start": 6.423,
   "end": 9.385,
   "w0": 17,
   "w1": 26
  },
  {
   "text": "Así que cada vez que piensas en el gimnasio,",
   "start": 9.462,
   "end": 11.769,
   "w0": 27,
   "w1": 35
  },
  {
   "text": "en estudiar, o en ese proyecto...",
   "start": 11.808,
   "end": 14.077,
   "w0": 36,
   "w1": 41
  },
  {
   "text": "te susurra:",
   "start": 14.115,
   "end": 14.846,
   "w0": 42,
   "w1": 43
  },
  {
   "text": "mañana.",
   "start": 15.346,
   "end": 15.846,
   "w0": 44,
   "w1": 44
  },
  {
   "text": "No es pereza.",
   "start": 16.462,
   "end": 17.423,
   "w0": 45,
   "w1": 47
  },
  {
   "text": "Es ahorro.",
   "start": 17.615,
   "end": 18.308,
   "w0": 48,
   "w1": 49
  },
  {
   "text": "Y aquí viene lo que nadie te cuenta:",
   "start": 18.769,
   "end": 20.923,
   "w0": 50,
   "w1": 57
  },
  {
   "text": "las ganas no llegan antes de empezar.",
   "start": 21.0,
   "end": 23.231,
   "w0": 58,
   "w1": 64
  },
  {
   "text": "Llegan después.",
   "start": 23.908,
   "end": 24.846,
   "w0": 65,
   "w1": 66
  },
  {
   "text": "Dos personas.",
   "start": 25.385,
   "end": 26.346,
   "w0": 67,
   "w1": 68
  },
  {
   "text": "Las dos sin ganas.",
   "start": 26.538,
   "end": 27.962,
   "w0": 69,
   "w1": 72
  },
  {
   "text": "Un martes, a las siete de la tarde.",
   "start": 28.154,
   "end": 30.0,
   "w0": 73,
   "w1": 80
  },
  {
   "text": "Una espera a que le apetezca.",
   "start": 30.462,
   "end": 32.269,
   "w0": 81,
   "w1": 86
  },
  {
   "text": "Sigue esperando.",
   "start": 32.677,
   "end": 33.731,
   "w0": 87,
   "w1": 88
  },
  {
   "text": "La otra se pone las zapatillas.",
   "start": 34.0,
   "end": 35.692,
   "w0": 89,
   "w1": 94
  },
  {
   "text": "Solo eso.",
   "start": 36.077,
   "end": 36.615,
   "w0": 95,
   "w1": 96
  },
  {
   "text": "Dos minutos.",
   "start": 37.0,
   "end": 38.0,
   "w0": 97,
   "w1": 98
  },
  {
   "text": "Y a los dos minutos...",
   "start": 38.231,
   "end": 39.692,
   "w0": 99,
   "w1": 103
  },
  {
   "text": "ya no quiere parar.",
   "start": 39.769,
   "end": 40.769,
   "w0": 104,
   "w1": 107
  },
  {
   "text": "Porque la motivación no es la chispa.",
   "start": 41.154,
   "end": 43.154,
   "w0": 108,
   "w1": 114
  },
  {
   "text": "Es el humo.",
   "start": 43.462,
   "end": 44.154,
   "w0": 115,
   "w1": 117
  },
  {
   "text": "Solo sale cuando ya hay fuego.",
   "start": 44.538,
   "end": 46.231,
   "w0": 118,
   "w1": 123
  },
  {
   "text": "Así que no esperes a tener ganas.",
   "start": 46.615,
   "end": 48.385,
   "w0": 124,
   "w1": 130
  },
  {
   "text": "Enciende algo pequeño.",
   "start": 48.538,
   "end": 50.077,
   "w0": 131,
